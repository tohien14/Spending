# Sao chép file này thành ".env" rồi điền chuỗi kết nối PostgreSQL của bạn.
# Xem README.md mục "Cơ sở dữ liệu PostgreSQL" để biết cách lấy miễn phí
# (Neon, Supabase) hoặc cách tạo Postgres trên Render.
#
# Ví dụ định dạng: postgres://user:password@host:5432/database_name
# Nếu nhà cung cấp yêu cầu SSL (Neon/Supabase/Render đều yêu cầu), cứ giữ
# nguyên chuỗi họ đưa cho bạn — code đã tự bật SSL khi thấy không phải
# localhost.
DATABASE_URL=postgres://user:password@host:5432/database_name

# Cổng chạy server (tuỳ chọn, mặc định 5000)
PORT=5000
