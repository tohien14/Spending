# Sao chép file này thành ".env" rồi điền chuỗi kết nối PostgreSQL của bạn.
# Xem README.md mục "Cơ sở dữ liệu PostgreSQL" để biết cách lấy miễn phí
# (Neon, Supabase) hoặc cách tạo Postgres trên Render.
#
# Ví dụ định dạng: postgres://user:password@host:5432/database_name
# Nếu nhà cung cấp yêu cầu SSL (Neon/Supabase/Render đều yêu cầu), cứ giữ
# nguyên chuỗi họ đưa cho bạn — code đã tự bật SSL khi thấy không phải
# localhost.
DATABASE_URL=postgres://user:password@host:5432/database_name

# Cổng chạy server (tuỳ chọn, mặc định 5000)
PORT=5000

# ---------- Tài khoản (2 người dùng, dữ liệu tách biệt hoàn toàn) ----------
# Không bắt buộc phải đặt — nếu bỏ trống, hệ thống dùng sẵn 2 tài khoản mặc
# định: hien/1234& và duc/1234@. Đặt các biến dưới đây nếu bạn muốn đổi tên
# đăng nhập/mật khẩu mà không cần sửa code. Chỉ áp dụng cho LẦN CHẠY ĐẦU
# TIÊN (lúc tài khoản được tạo trong database) — đổi sau đó sẽ không có
# tác dụng với tài khoản đã tồn tại.
USER1_USERNAME=hien
USER1_PASSWORD=1234&
USER1_DISPLAY_NAME=Hiền

USER2_USERNAME=duc
USER2_PASSWORD=1234@
USER2_DISPLAY_NAME=Đức

USER3_USERNAME=loan
USER3_PASSWORD=1234
USER3_DISPLAY_NAME=Loan

# Muốn thêm tài khoản thứ 3, 4... chỉ cần bỏ dấu # ở 3 dòng dưới và điền
# thông tin — KHÔNG cần sửa code gì cả. Cứ tăng số (USER4_..., USER5_...)
# để thêm tiếp nếu cần.
# USER3_USERNAME=an
# USER3_PASSWORD=doi-mat-khau-nay
# USER3_DISPLAY_NAME=

# Chuỗi bí mật dùng để ký phiên đăng nhập (tuỳ chọn nhưng nên đặt cho an
# toàn hơn — một chuỗi ngẫu nhiên, càng dài càng tốt). Nếu bỏ trống, hệ
# thống dùng 1 giá trị mặc định có sẵn trong code (vẫn hoạt động, chỉ kém
# an toàn hơn một chút — chấp nhận được với app dùng trong gia đình).
JWT_SECRET=doi-thanh-1-chuoi-ngau-nhien-cua-rieng-ban

# ---------- Tự động xoá dữ liệu cũ ----------
# Số THÁNG được giữ lại, tính cả tháng hiện tại. Mặc định 3 = giữ tháng
# này + 2 tháng trước, dữ liệu từ tháng thứ 4 trở về trước sẽ bị XOÁ VĨNH
# VIỄN mỗi khi backend khởi động (và lặp lại mỗi 24h nếu backend chạy liên
# tục không tắt). Ví dụ đang ở tháng 12: giữ tháng 10/11/12, xoá hết dữ
# liệu từ tháng 9 trở về trước.
# Đặt số lớn hơn nếu muốn giữ lâu hơn (VD 12 = giữ cả năm). KHÔNG có cách
# khôi phục sau khi đã xoá — nếu cần giữ lâu dài, hãy tự sao lưu định kỳ
# (xem mục "Sao lưu dữ liệu" trong README) trước khi dữ liệu tới hạn.
RETENTION_MONTHS=3
